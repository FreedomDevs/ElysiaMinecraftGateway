#!/usr/bin/env python3
import sys
import nbtlib
from nbtlib.tag import Compound, String, List, Byte

# 1. Текст с информацией о необходимости входа
# Minecraft поддерживает форматированный JSON внутри поля текста/заголовка
body_text = String('{"text": "Для продолжения игры вам необходимо пройти авторизацию на нашем сайте.", "color": "white"}')

# 2. Кнопка с кликабельной ссылкой (open_url)
# Диалог рендерит интерактивные кнопки или элементы ввода из массива buttons/actions
buttons = List[Compound]([
    Compound({
        "label": String('{"text": "[ Нажмите здесь, чтобы пройти авторизацию ]", "color": "blue", "underlined": true}'),
        "action": Compound({
            "type": String("open_url"),
            "url": String("https://example.com/login")
        })
    })
])

# 3. Собираем итоговую структуру NBT-диалога
dialog_tag = Compound({
    "title": String('{"text": "Авторизация требуется", "color": "gold", "bold": true}'),
    "body": body_text,
    "buttons": buttons,
    "pause": Byte(1)  # Заставляет игру встать на паузу (для одиночки) или заблокировать задний фон
})

# Оборачиваем в корневой тег
root = Compound({
    "data": dialog_tag
})

# Сохраняем в несжатом бинарном виде (uncompressed NBT)
nbt_file = nbtlib.File(root, gzipped=False)
nbt_file.write(sys.stdout.buffer)
